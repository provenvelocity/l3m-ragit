#!/bin/sh
set -eu

image="${L3M_RAGIT_CBM_IMAGE:-l3m-ragit/codebase-memory-mcp:0.11.0}"
root="${CBM_ALLOWED_ROOT:-$PWD}"
case "$root" in
  /*) ;;
  *) root="$(cd "$root" && pwd -P)" ;;
esac

if command -v sha256sum >/dev/null 2>&1; then
  workspace_id="$(printf '%s' "$root" | sha256sum | cut -c1-16)"
else
  workspace_id="$(printf '%s' "$root" | shasum -a 256 | cut -c1-16)"
fi

container="l3m-ragit-cbm-$workspace_id"
cache_base="${L3M_RAGIT_CBM_CACHE_BASE:-${XDG_CACHE_HOME:-$HOME/.cache}/l3m-ragit/cbm}"
cache="$cache_base/$workspace_id"

command -v docker >/dev/null 2>&1 || { echo "docker is not installed or is not on PATH" >&2; exit 127; }
docker image inspect "$image" >/dev/null 2>&1 || {
  echo "Docker image $image is missing. Build it from the l3m-ragit repository:" >&2
  echo "  docker build -f docker/Dockerfile -t $image ." >&2
  exit 1
}
mkdir -p "$cache"

if docker container inspect "$container" >/dev/null 2>&1; then
  container_image="$(docker container inspect --format '{{.Image}}' "$container")"
  requested_image="$(docker image inspect --format '{{.Id}}' "$image")"
  if [ "$container_image" != "$requested_image" ]; then
    docker rm -f "$container" >/dev/null
  fi
fi

if ! docker container inspect "$container" >/dev/null 2>&1; then
  docker run -d \
    --name "$container" \
    --label l3m-ragit.workspace="$workspace_id" \
    --user "$(id -u):$(id -g)" \
    --env HOME=/tmp \
    --env CBM_CACHE_DIR=/cbm-cache \
    --env CBM_ALLOWED_ROOT="$root" \
    --volume "$root:$root:ro" \
    --volume "$cache:/cbm-cache" \
    --workdir "$root" \
    --entrypoint /bin/sh \
    "$image" \
    -c 'trap "exit 0" TERM INT; while :; do sleep 3600 & wait $!; done' >/dev/null || {
      docker container inspect "$container" >/dev/null 2>&1 || exit 1
    }
fi

if [ "$(docker container inspect --format '{{.State.Running}}' "$container")" != "true" ]; then
  docker start "$container" >/dev/null
fi

exec docker exec -i \
  --workdir "$root" \
  --env CBM_ALLOWED_ROOT="$root" \
  --env CBM_CACHE_DIR=/cbm-cache \
  "$container" \
  codebase-memory-mcp "$@"
